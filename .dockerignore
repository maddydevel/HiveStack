# ============================================================================
# HiveStack Local Development .dockerignore
# ============================================================================

# Version control
.git
.gitignore
.gitattributes

# Build output
bin/
dist/
*.exe
*.test
*.out
coverage.out
sbom.json

# Go workspace
go.work
go.work.sum

# Environment and secrets
.env
.env.*
*.pem
*.key
*.crt

# Editor and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Documentation and repo metadata not needed in images
docs/
*.md
CODEOWNERS
LICENSE
SECURITY.md

# CI and local tooling
.github/
.golangci.yml

# Existing Docker files (avoid recursive copies)
appliance/Dockerfile
docker-compose*.yml
docker-compose*.yaml

# Scripts (only copied explicitly in Dockerfile)
scripts/

# Test files (not needed in production image)
tests/
*_test.go

# Local config examples that may contain secrets
config/*.yaml
config/*.yml
config/*.example

# Systemd (reference only, not used in container)
systemd/

# Migration files are copied explicitly, but ignore any local overrides
migration/
